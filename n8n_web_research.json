{
  "name": "CiteOS Web Auto-Research (Academic APIs)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "web-research",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [220, 240],
      "webhookId": "web-research"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.semanticscholar.org/graph/v1/paper/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.body.topicName }}"
            },
            {
              "name": "limit",
              "value": "10"
            },
            {
              "name": "fields",
              "value": "title,abstract,url"
            }
          ]
        },
        "options": {}
      },
      "id": "semantic-scholar-search",
      "name": "Search Semantic Scholar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 240]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-results",
      "name": "Split Out Results",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [660, 240]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nif (!item.abstract) {\n  return []; // drop item if no abstract\n}\n\nreturn {\n  json: {\n    text: item.abstract,\n    title: item.title || 'Unknown',\n    url: item.url || ('https://semanticscholar.org/paper/' + item.paperId),\n    topicId: $('Webhook').first().json.body.topicId\n  }\n};"
      },
      "id": "parse-text",
      "name": "Parse Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/vectorize",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "static_internal_token_citeos_123"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": [{{ JSON.stringify($json.text) }}],\n  \"url\": \"{{ $json.url }}\",\n  \"topicId\": \"{{ $json.topicId }}\"\n}",
        "options": {}
      },
      "id": "push-citeos",
      "name": "Push to CiteOS API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1060, 240]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Search Semantic Scholar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Semantic Scholar": {
      "main": [
        [
          {
            "node": "Split Out Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out Results": {
      "main": [
        [
          {
            "node": "Parse Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Text": {
      "main": [
        [
          {
            "node": "Push to CiteOS API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
